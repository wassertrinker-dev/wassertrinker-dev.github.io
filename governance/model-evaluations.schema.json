{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model evaluation record",
  "type": "object",
  "required": ["schemaVersion", "evaluations"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "evaluations": {
      "type": "array",
      "items": { "$ref": "#/$defs/evaluation" }
    }
  },
  "$defs": {
    "reasoning": {
      "type": "object",
      "required": ["nativeSetting", "normalizedLevel"],
      "additionalProperties": false,
      "properties": {
        "nativeSetting": { "type": "string", "minLength": 1 },
        "normalizedLevel": { "type": ["integer", "null"], "minimum": 1, "maximum": 6 }
      }
    },
    "model": {
      "type": "object",
      "required": ["provider", "model", "reasoning"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "reasoning": { "$ref": "#/$defs/reasoning" }
      }
    },
    "measurement": {
      "type": "object",
      "required": ["durationMinutes", "inputTokens", "outputTokens", "costUsd"],
      "additionalProperties": false,
      "properties": {
        "durationMinutes": { "type": ["number", "null"], "minimum": 0 },
        "inputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "outputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "costUsd": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "evaluation": {
      "type": "object",
      "required": [
        "issueNumber",
        "storyType",
        "storyPoints",
        "riskClass",
        "recommendation",
        "execution",
        "outcome",
        "assessment",
        "comparisonCandidate"
      ],
      "additionalProperties": false,
      "properties": {
        "issueNumber": { "type": "integer", "minimum": 1 },
        "storyType": { "type": "string", "minLength": 1 },
        "storyPoints": { "enum": [1, 2, 3, 5, 8, 13, 21] },
        "riskClass": { "enum": ["low", "medium", "high"] },
        "recommendation": {
          "type": "object",
          "required": ["model", "rationale"],
          "additionalProperties": false,
          "properties": {
            "model": { "$ref": "#/$defs/model" },
            "rationale": { "type": "string", "minLength": 1 }
          }
        },
        "execution": {
          "type": "object",
          "required": ["model", "environment", "metadataSource"],
          "additionalProperties": false,
          "properties": {
            "model": { "$ref": "#/$defs/model" },
            "environment": { "enum": ["hosted", "local"] },
            "metadataSource": { "enum": ["verified-metadata", "human-confirmed"] }
          }
        },
        "outcome": {
          "type": "object",
          "required": ["mergedAt", "mergeGate", "acceptanceCriteria", "rework", "measurement"],
          "additionalProperties": false,
          "properties": {
            "mergedAt": { "type": "string", "format": "date-time" },
            "mergeGate": { "const": "GO" },
            "acceptanceCriteria": { "const": "passed" },
            "rework": { "enum": ["none", "minor", "material"] },
            "measurement": { "$ref": "#/$defs/measurement" }
          }
        },
        "assessment": { "enum": ["fit", "oversized", "insufficient"] },
        "comparisonCandidate": {
          "type": ["object", "null"],
          "required": ["provider", "model", "reason"],
          "additionalProperties": false,
          "properties": {
            "provider": { "type": "string", "minLength": 1 },
            "model": { "type": "string", "minLength": 1 },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
