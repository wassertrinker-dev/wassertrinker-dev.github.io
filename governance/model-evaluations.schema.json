{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model decision record",
  "type": "object",
  "required": ["schemaVersion", "modelRecords"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "modelRecords": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "reasoning": {
      "type": "object",
      "required": ["nativeSetting", "normalizedLevel"],
      "additionalProperties": false,
      "properties": {
        "nativeSetting": { "type": "string", "minLength": 1 },
        "normalizedLevel": { "type": ["integer", "null"], "minimum": 1, "maximum": 6 }
      }
    },
    "model": {
      "type": "object",
      "required": ["provider", "model", "reasoning"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "reasoning": { "$ref": "#/$defs/reasoning" }
      }
    },
    "record": {
      "type": "object",
      "required": ["issueNumber", "storyType", "storyPoints", "riskClass", "recommendation", "execution"],
      "additionalProperties": false,
      "properties": {
        "issueNumber": { "type": "integer", "minimum": 1 },
        "storyType": { "type": "string", "minLength": 1 },
        "storyPoints": { "enum": [1, 2, 3, 5, 8, 13, 21] },
        "riskClass": { "enum": ["low", "medium", "high"] },
        "recommendation": {
          "type": "object",
          "required": ["model", "rationale"],
          "additionalProperties": false,
          "properties": {
            "model": { "$ref": "#/$defs/model" },
            "rationale": { "type": "string", "minLength": 1 }
          }
        },
        "execution": {
          "type": "object",
          "required": ["model", "environment", "metadataSource"],
          "additionalProperties": false,
          "properties": {
            "model": { "$ref": "#/$defs/model" },
            "environment": { "enum": ["hosted", "local"] },
            "metadataSource": { "enum": ["verified-metadata", "human-confirmed"] }
          }
        }
      }
    }
  }
}
